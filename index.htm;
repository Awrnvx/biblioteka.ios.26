    if (this.slider.fraction <= 0.0005) finalX = 0;
    if (this.slider.fraction >= 0.9995) finalX = this.TRAVEL;

    if (finalX <= 0)           pivotShift = Math.max(0, pivotShift);
    if (finalX >= this.TRAVEL) pivotShift = Math.min(0, pivotShift);

    this.knob.style.transformOrigin = originX + '% 50%';
    this.knob.style.transform =
      'translate3d(' + (finalX + pivotShift) + 'px,' + (ty - this.KNOB_H / 2) + 'px,0) ' +
      'scale(' + scaleX + ',' + scaleY + ')';

    if (this.knobAmbient){
      this.knobAmbient.style.transform =
        'translate3d(' + (finalX + pivotShift) + 'px,' + (-this.KNOB_H / 2) + 'px,0)';
      this.knobAmbient.style.opacity = (0.85 + 0.15 * progress).toFixed(3);
    }

    this.knob.style.setProperty('--lx', (50 + (this.state.offset.x / w) * 100) + '%');
    this.knob.style.setProperty('--ly', (50 + (this.state.offset.y / h) * 100) + '%');
  };

  Slider.prototype._bind = function () {
    var self = this;
    var sliderEl = this.sliderEl;
    var knob = this.knob;

    var knobRectCache = null;
    var sliderRectCache = null;

    function updateOffset(e){
      var rect = knobRectCache || knob.getBoundingClientRect();
      var p = getPoint(e);
      var mx = rect.left + rect.width / 2;
      var my = rect.top + rect.height / 2;
      var maxOff = Math.max(rect.width, rect.height) * self.OFFSET_LIMIT;
      var dx = p.x - mx, dy = p.y - my;
      var len = Math.hypot(dx, dy);
      if (len > maxOff && len > 0){ dx = dx / len * maxOff; dy = dy / len * maxOff; }
      self.state.targetOffset.x = dx;
      self.state.targetOffset.y = dy;
    }

    function spawnRipple(e){
      var layer = knob.querySelector('.ripple-layer');
      if (!layer) return;
      var rect = knobRectCache || knob.getBoundingClientRect();
      var p = getPoint(e);
      var r = document.createElement('span');
      r.className = 'ripple';
      r.style.left = (p.x - rect.left) + 'px';
      r.style.top  = (p.y - rect.top) + 'px';
      layer.appendChild(r);
      setTimeout(function(){ if (r.parentNode) r.parentNode.removeChild(r); }, 600);
    }

    function clientXToFraction(clientX){
      var rect = sliderRectCache || sliderEl.getBoundingClientRect();
      var x = clientX - rect.left - self.KNOB_W / 2;
      return Math.max(0, Math.min(1, x / self.TRAVEL));
    }

    var activePointerId = null;
    var startPointerX = 0;
    var startFraction = 0;

    function onPointerDown(e){
      if (activePointerId !== null) return;
      activePointerId = e.pointerId;
      try { sliderEl.setPointerCapture(activePointerId); } catch (_) {}

      knobRectCache = knob.getBoundingClientRect();
      sliderRectCache = sliderEl.getBoundingClientRect();

      self.state.isPressed = true;
      self.state.targetPress = 1;
      knob.classList.add('is-active');
      if (navigator.vibrate){ try { navigator.vibrate(8); } catch (_) {} }

      updateOffset(e);

      var onKnob = (e.target === knob || knob.contains(e.target));
      if (onKnob){
        spawnRipple(e);
      } else {
        var f = clientXToFraction(e.clientX);
        self.slider.target = f;
        self.slider.velocity = 0;
        self.slider.dragDelta = 0;
      }

      startPointerX = e.clientX;
      startFraction = self.slider.fraction;

      self.pill.lastPointerX = e.clientX;
      self.pill.lastTime = performance.now();
      self.pill.lastSpeed = 0;
      self.pill.stretch = 0;
      self.pill.targetStretch = 0;

      self.slider.dragging = true;
      self._start();
      e.preventDefault();
    }

    function onPointerMove(e){
      if (e.pointerId !== activePointerId) return;
      updateOffset(e);

      var p = getPoint(e);
      var dx = p.x - startPointerX;

      var f = startFraction + dx / self.TRAVEL;
      f = Math.max(0, Math.min(1, f));

      self.slider.fraction = f;
      self.slider.target = f;
      self.slider.velocity = 0;

      var desiredX = startFraction * self.TRAVEL + dx;
      var allowedX = f * self.TRAVEL;
      var d = desiredX - allowedX;
      if (d > self.DRAG_X_LIMIT) d = self.DRAG_X_LIMIT;
      if (d < -self.DRAG_X_LIMIT) d = -self.DRAG_X_LIMIT;
      self.slider.dragDelta = d;

      var now = performance.now();
      var dtMs = now - self.pill.lastTime;
      if (dtMs < 1) dtMs = 1;

      var instDx = p.x - self.pill.lastPointerX;
      var speed = (instDx / dtMs) * 1000;
      self.pill.lastPointerX = p.x;
      self.pill.lastTime = now;
      self.pill.lastSpeed = speed;

      var absSpeed = Math.abs(speed);

      var targetMagnitude = 0;
      if (absSpeed > self.PILL_SPEED_DEAD){
        var t = (absSpeed - self.PILL_SPEED_DEAD) / (self.PILL_SPEED_MAX - self.PILL_SPEED_DEAD);
        if (t > 1) t = 1;
        targetMagnitude = Math.tanh(t * 2.4) / Math.tanh(2.4);
      }

      var dir = speed >= 0 ? 1 : -1;
      var newTarget = dir * targetMagnitude;

      self.pill.targetStretch = self.pill.targetStretch * 0.5 + newTarget * 0.5;

      if (self.pill.targetStretch >  1) self.pill.targetStretch =  1;
      if (self.pill.targetStretch < -1) self.pill.targetStretch = -1;

      self._start();
      e.preventDefault();
    }

    function onPointerUp(e){
      if (e.pointerId !== activePointerId) return;
      try { sliderEl.releasePointerCapture(activePointerId); } catch (_) {}
      activePointerId = null;

      self.state.isPressed = false;
      self.state.targetPress = 0;
      self.state.targetOffset.x = 0;
      self.state.targetOffset.y = 0;
      knob.classList.remove('is-active');

      self.slider.dragging = false;

      var v = self._fractionToValue(self.slider.fraction);
      self.slider.target = self._valueToFraction(v);

      if (self.onChange) self.onChange(v, self);
      self._start();
    }

    sliderEl.addEventListener('pointerdown', onPointerDown);
    global.addEventListener('pointermove', onPointerMove, {passive:false});
    global.addEventListener('pointerup', onPointerUp);
    global.addEventListener('pointercancel', onPointerUp);

    global.addEventListener('resize', function(){
      knobRectCache = null;
      sliderRectCache = null;
    });

    sliderEl.addEventListener('keydown', function(e){
      var v = self._fractionToValue(self.slider.fraction);
      var step = e.shiftKey ? 10 : 1;
      var handled = true;
      if (e.key === 'ArrowRight')      v = Math.min(self.MAX, v + step);
      else if (e.key === 'ArrowLeft')  v = Math.max(self.MIN, v - step);
      else if (e.key === 'ArrowUp')    v = Math.min(self.MAX, v + step);
      else if (e.key === 'ArrowDown')  v = Math.max(self.MIN, v - step);
      else if (e.key === 'PageUp')     v = Math.min(self.MAX, v + 10);
      else if (e.key === 'PageDown')   v = Math.max(self.MIN, v - 10);
      else if (e.key === 'Home')       v = self.MIN;
      else if (e.key === 'End')        v = self.MAX;
      else handled = false;

      if (handled){
        e.preventDefault();
        self.slider.dragging = false;
        self.slider.target = self._valueToFraction(v);
        self.slider.velocity = 0;
        if (self.onChange) self.onChange(v, self);
        self._start();
      }
    });
  };

  /* ============================================================
   * Публичный API
   * ============================================================ */
  var LiquidGlass = {
    Pill: Pill,
    Toggle: Toggle,
    Slider: Slider,

    init: function (root) {
      root = root || document;
      var out = { pills: [], toggles: [], sliders: [] };

      root.querySelectorAll('[data-lg-pill]').forEach(function (el) {
        out.pills.push(new Pill(el, {}));
      });

      root.querySelectorAll('[data-lg-toggle]').forEach(function (el) {
        out.toggles.push(new Toggle(el, {}));
      });

      root.querySelectorAll('[data-lg-slider]').forEach(function (el) {
        out.sliders.push(new Slider(el, {
          wrap: el.closest('.slider-wrap') || el.parentElement
        }));
      });

      return out;
    }
  };

  global.LiquidGlass = LiquidGlass;
})(window);

/* ============================================================
 * ДЕМО
 * ============================================================ */
(function () {
  // init после полной загрузки, чтобы размеры посчитались
  function boot() {
    var inst = LiquidGlass.init(document);
    console.log('LiquidGlass инициализирован:', inst);
  }
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setTimeout(boot, 0);
  } else {
    window.addEventListener('DOMContentLoaded', boot);
  }
})();
</script>
